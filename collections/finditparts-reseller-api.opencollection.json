      "items": [
        {
          "info": {
            "name": "Product Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://finditparts.com/api/v1/products/:product_id",
            "params": [
              {
                "name": "include_pies_data",
                "value": "",
                "type": "query"
              },
              {
                "name": "product_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the Product Details\n\nRequires a generic JWT in the Authorization header.\n\nUse a customer referenced JWT to return account specific pricing or a Generic JWT token (no customer reference) to return list price."
        },
        {
          "info": {
            "name": "Product Details Multi",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://finditparts.com/api/v1/products/:product_ids/multi",
            "params": [
              {
                "name": "product_ids",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the Product Details for each comma separated ID.\n\nRequires a generic JWT in the Authorization header.\n\nUse a customer referenced JWT to return account specific pricing or a Generic JWT token (no customer reference) to return list price."
        },
        {
          "info": {
            "name": "Lookup Product by Part Number",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://finditparts.com/api/v1/products/lookup",
            "params": [
              {
                "name": "part_number",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the Product Details for each Product that exactly matches the part number provided. Results are split by part number exact matches and cross reference exact matches.\n\nRequires a generic JWT in the Authorization header.\n\nUse a customer referenced JWT to return account specific pricing or a Generic JWT token (no customer reference) to return list price."
        },
